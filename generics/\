use std::f32::consts::PI;

fn make_tuple<T, U>(first: T, second: U) -> (T, U) {
    (first, second)
}

fn main() {
    // you can basically use turbofish or not in this instance
    // there are instances when we are required to specify a type in order
    // to satisfy the generic and have end to end typing
    let first = make_tuple::<i32, &str>(5, "hello");
    let second = make_tuple::<i32, i32>(5, 13);
    let third = make_tuple::<bool, f32>(true, PI);
    let fourth = make_tuple(true, false);

    dbg!("{} | {} | {} | {}", first, second, third, fourth);
}
