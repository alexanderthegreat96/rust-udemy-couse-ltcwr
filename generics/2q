#![allow(dead_code)]
#[derive(Debug)]
struct TreasureChest<T> {
    captain: String,
    treasure: T,
}

#[derive(Debug)]
struct User<T> {
    name: String,
    height: T, // allow height to be of type i32 or f32
    metric: &'static str,
}

fn main() {
    let gold_chest = TreasureChest {
        captain: String::from("Firebeard"),
        treasure: "Gold",
    };
    println!("{:?}", gold_chest);

    let silver_chest = TreasureChest {
        captain: String::from("Bloodsail"),
        treasure: String::from("Silver"),
    };
    println!("{:?}", silver_chest);

    let special_chest = TreasureChest {
        captain: String::from("Bootyplunder"),
        treasure: ["Gold", "Silver", "Platinum"],
    };
    println!("{:?}", special_chest);

    // in my case i specified the type i want to use
    // since height is of type T -> i gave it i32
    let first: User<i32> = User {
        name: String::from("Mike"),
        height: 180,
        metric: "metric",
    };

    println!("First User: {:?}", first);

    // in here i specified the type of T as being f32
    // for 6 feet 3 inches
    let second: User<f32> = User {
        name: String::from("David"),
        height: 6.3,
        metric: "imperial",
    };

    println!("Second user: {:?}", second);
}
